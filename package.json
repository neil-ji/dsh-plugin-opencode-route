{
  "name": "dsh-plugin-opencode-route",
  "version": "1.10.7",
  "description": "Pins each OpenCode Go session to a fast gateway route by probing candidate x-opencode-session ids, without sacrificing its prompt cache.",
  "type": "module",
  "license": "MIT",
  "author": "Neil Ji",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "routing",
    "gateway",
    "latency"
  ],
  "homepage": "https://github.com/neil-ji/dsh-plugin-opencode-route#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-plugin-opencode-route.git"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-plugin-opencode-route/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "research",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
